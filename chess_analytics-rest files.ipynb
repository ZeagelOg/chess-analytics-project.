    "ax2.set_xlabel('Win Rate (%)', color='#8892a4')\n",
    "ax2.set_xlim(0, 105)\n",
    "ax2.set_facecolor('#1a1f2e')\n",
    "ax2.legend(facecolor='#1a1f2e', edgecolor='#2a3040', labelcolor='white')\n",
