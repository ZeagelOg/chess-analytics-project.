    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "fig.patch.set_facecolor('#0f1117')\n",
    "\n",
    "# --- Pie Chart: Overall Results ---\n",
    "ax1 = axes[0]\n",
    "labels = ['Wins', 'Losses', 'Draws']\n",
    "sizes = [wins, losses, draws]\n",
    "colors = ['#00c896', '#ff5a5a', '#ffb830']\n",
    "explode = (0.05, 0.05, 0.05)\n",
    "wedges, texts, autotexts = ax1.pie(\n",
    "    sizes, labels=labels, colors=colors,\n",
    "    autopct='%1.1f%%', startangle=90, explode=explode,\n",
    "    textprops={'color': 'white', 'fontsize': 12},\n",
    "    wedgeprops={'edgecolor': '#0f1117', 'linewidth': 2}\n",
    ")\n",
    "for at in autotexts:\n",
    "    at.set_fontsize(11)\n",
    "    at.set_fontweight('bold')\n",
    "ax1.set_title(f'Overall Results\\n({total} games)', color='white', fontsize=14, fontweight='bold', pad=20)\n",
    "ax1.set_facecolor('#0f1117')\n",
    "\n",
    "# --- Bar Chart: Win Rate by Time Control ---\n",
    "ax2 = axes[1]\n",
    "tc_stats = df.groupby('time_class').agg(\n",
    "    win_rate=('win', 'mean'),\n",
    "    total=('win', 'count')\n",
    ").reset_index()\n",
    "tc_stats['win_rate'] = tc_stats['win_rate'] * 100\n",
    "tc_order = ['Bullet', 'Blitz', 'Rapid', 'Classical']\n",
    "tc_stats = tc_stats[tc_stats['time_class'].isin(tc_order)]\n",
