    "def get_all_games(username):\n",
    "    \"\"\"\n",
    "    Fetches all available games from Chess.com public API.\n",
    "    No API key needed - Chess.com API is completely free and open!\n",
    "    \"\"\"\n",
    "    headers = {'User-Agent': 'ChessAnalyticsProject/1.0'}\n",
    "    \n",
    "    # Step 1: Get list of available months\n",
    "    archives_url = f'https://api.chess.com/pub/player/{username}/games/archives'\n",
    "    resp = requests.get(archives_url, headers=headers)\n",
    "    \n",
    "    if resp.status_code != 200:\n",
    "        print(f'ERROR: Could not find user \"{username}\". Check your username!')\n",
    "        return []\n",
    "    \n",
    "    archives = resp.json()['archives']\n",
    "    print(f'Found {len(archives)} months of games for {username}')\n",
    "    \n",
    "    # Step 2: Fetch games from last 12 months (to keep it fast)\n",
    "    all_games = []\n",
    "    recent_archives = archives[-12:]  # Last 12 months\n",
    "    \n",
    "    for i, url in enumerate(recent_archives):\n",
    "        resp = requests.get(url, headers=headers)\n",
    "        if resp.status_code == 200:\n",
    "            games = resp.json().get('games', [])\n",
    "            all_games.extend(games)\n",
    "            month = url.split('/')[-2] + '/' + url.split('/')[-1]\n",
    "            print(f'  Month {month}: {len(games)} games fetched')\n",
    "    \n",
    "    print(f'\\nTotal games fetched: {len(all_games)}')\n",
    "    return all_games\n",
    "\n",
    "raw_games = get_all_games(USERNAME)"
   ]
  },
