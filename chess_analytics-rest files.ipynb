    "# Color preference\n",
    "white_wr = df[df['my_color'] == 'White']['win'].mean() * 100\n",
    "black_wr = df[df['my_color'] == 'Black']['win'].mean() * 100\n",
    "print(f'6. Win rate as White: {white_wr:.1f}% | as Black: {black_wr:.1f}%')\n",
