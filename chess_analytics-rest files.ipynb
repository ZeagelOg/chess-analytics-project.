    "def parse_games(raw_games, username):\n",
    "    \"\"\"\n",
    "    Converts raw Chess.com API response into a clean, analysis-ready DataFrame.\n",
    "    \"\"\"\n",
    "    records = []\n",
    "    username_lower = username.lower()\n",
    "    \n",
    "    for game in raw_games:\n",
    "        try:\n",
    "            white = game['white']['username'].lower()\n",
    "            black = game['black']['username'].lower()\n",
    "            \n",
    "            # Determine if user played as White or Black\n",
    "            my_color = 'white' if white == username_lower else 'black'\n",
    "            opp_color = 'black' if my_color == 'white' else 'white'\n",
    "            \n",
    "            my_result = game[my_color]['result']\n",
    "            opp_username = game[opp_color]['username']\n",
    "            opp_rating = game[opp_color].get('rating', 0)\n",
    "            my_rating = game[my_color].get('rating', 0)\n",
    "            \n",
    "            # Simplify result to Win / Loss / Draw\n",
    "            if my_result == 'win':\n",
    "                result = 'Win'\n",
    "            elif my_result in ['checkmated', 'timeout', 'resigned', 'abandoned']:\n",
    "                result = 'Loss'\n",
    "            else:\n",
    "                result = 'Draw'\n",
    "            \n",
    "            # Time control label\n",
    "            tc = game.get('time_control', '600')\n",
    "            tc_num = int(tc.split('+')[0]) if '+' in tc else int(tc)\n",
    "            if tc_num < 180:\n",
    "                time_class = 'Bullet'\n",
    "            elif tc_num < 600:\n",
    "                time_class = 'Blitz'\n",
    "            elif tc_num < 1800:\n",
    "                time_class = 'Rapid'\n",
    "            else:\n",
    "                time_class = 'Classical'\n",
    "            \n",
    "            # Parse date and time\n",
    "            end_time = game.get('end_time', 0)\n",
    "            dt = datetime.utcfromtimestamp(end_time)\n",
    "            \n",
    "            # Extract opening from PGN\n",
    "            pgn_text = game.get('pgn', '')\n",
    "            opening = 'Unknown'\n",
    "            eco = 'A00'\n",
    "            opening_match = re.search(r'\\[Opening \"(.+?)\"\\]', pgn_text)\n",
    "            eco_match = re.search(r'\\[ECO \"(.+?)\"\\]', pgn_text)\n",
    "            if opening_match:\n",
    "                opening = opening_match.group(1)\n",
    "            if eco_match:\n",
    "                eco = eco_match.group(1)\n",
    "            \n",
    "            # Count moves\n",
    "            moves_match = re.findall(r'\\d+\\.\\s', pgn_text)\n",
    "            num_moves = len(moves_match)\n",
    "            \n",
    "            # Termination reason\n",
    "            term_match = re.search(r'\\[Termination \"(.+?)\"\\]', pgn_text)\n",
    "            termination = term_match.group(1) if term_match else 'Unknown'\n",
    "            \n",
    "            records.append({\n",
    "                'date': dt.date(),\n",
    "                'month': dt.strftime('%Y-%m'),\n",
    "                'day_of_week': dt.strftime('%A'),\n",
    "                'hour': dt.hour,\n",
    "                'my_color': my_color.capitalize(),\n",
    "                'my_rating': my_rating,\n",
    "                'opp_username': opp_username,\n",
    "                'opp_rating': opp_rating,\n",
    "                'rating_diff': my_rating - opp_rating,\n",
    "                'result': result,\n",
    "                'result_detail': my_result,\n",
    "                'time_class': time_class,\n",
    "                'time_control': tc,\n",
    "                'opening': opening,\n",
    "                'eco': eco,\n",
    "                'eco_family': eco[0],\n",
    "                'num_moves': num_moves,\n",
    "                'termination': termination,\n",
    "            })\n",
    "        except Exception as e:\n",
    "            continue\n",
    "    \n",
    "    df = pd.DataFrame(records)\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    df['win'] = (df['result'] == 'Win').astype(int)\n",
    "    df['loss'] = (df['result'] == 'Loss').astype(int)\n",
    "    df['draw'] = (df['result'] == 'Draw').astype(int)\n",
    "    \n",
    "    return df\n",
    "\n",
    "df = parse_games(raw_games, USERNAME)\n",
    "print(f'Clean DataFrame shape: {df.shape}')\n",
    "print(f'\\nColumn names: {list(df.columns)}')\n",
    "df.head()"
   ]
