    "# Game length\n",
    "avg_moves = df['num_moves'].mean()\n",
    "short_wr = df[df['num_moves'] < 25]['win'].mean() * 100\n",
    "long_wr = df[df['num_moves'] >= 40]['win'].mean() * 100\n",
    "print(f'7. Avg game length: {avg_moves:.0f} moves')\n",
    "print(f'   Win rate in short games (<25 moves): {short_wr:.1f}%')\n",
    "print(f'   Win rate in long games (40+ moves):  {long_wr:.1f}%')\n",
