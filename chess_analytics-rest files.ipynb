    "# Get openings played at least 5 times\n",
    "opening_stats = df.groupby('opening').agg(\n",
    "    total=('result', 'count'),\n",
    "    wins=('win', 'sum'),\n",
    "    losses=('loss', 'sum'),\n",
    "    draws=('draw', 'sum')\n",
    ").reset_index()\n",
    "opening_stats = opening_stats[opening_stats['total'] >= 5]\n",
    "opening_stats['win_rate'] = opening_stats['wins'] / opening_stats['total'] * 100\n",
    "opening_stats = opening_stats.sort_values('total', ascending=False).head(12)\n",
    "\n",
    "# Shorten long opening names\n",
    "opening_stats['short_name'] = opening_stats['opening'].apply(\n",
    "    lambda x: x[:35] + '...' if len(x) > 35 else x\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
    "fig.patch.set_facecolor('#0f1117')\n",
    "\n",
    "# --- Top Openings by Games Played ---\n",
    "ax1 = axes[0]\n",
    "colors_bar = ['#00c896' if wr >= 50 else '#ff5a5a' for wr in opening_stats['win_rate']]\n",
    "bars = ax1.barh(opening_stats['short_name'], opening_stats['total'],\n",
    "                color=colors_bar, edgecolor='#0f1117', linewidth=1)\n",
    "for bar, row in zip(bars, opening_stats.itertuples()):\n",
    "    ax1.text(bar.get_width() + 0.2, bar.get_y() + bar.get_height()/2,\n",
    "             f'{row.total}g | {row.win_rate:.0f}% WR',\n",
    "             va='center', color='white', fontsize=9)\n",
    "ax1.set_title('Most Played Openings\\n(green = >50% win rate)', color='white', fontsize=13, fontweight='bold')\n",
    "ax1.set_xlabel('Games Played', color='#8892a4')\n",
    "ax1.set_facecolor('#1a1f2e')\n",
    "ax1.invert_yaxis()\n",
    "for spine in ax1.spines.values():\n",
    "    spine.set_edgecolor('#2a3040')\n",
    "ax1.tick_params(colors='white', labelsize=9)\n",
    "ax1.grid(axis='x', alpha=0.2)\n",
    "\n",
    "# --- Win Rate by Opening (top 10 by win rate, min 5 games) ---\n",
    "ax2 = axes[1]\n",
    "best_openings = opening_stats.sort_values('win_rate', ascending=True).tail(10)\n",
    "bars2 = ax2.barh(best_openings['short_name'], best_openings['win_rate'],\n",
    "                 color='#00c896', edgecolor='#0f1117', linewidth=1, alpha=0.85)\n",
    "ax2.axvline(x=50, color='#ffb830', linestyle='--', alpha=0.7, label='50% line')\n",
